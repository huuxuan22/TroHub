# Copy to .env — trong Docker dùng host.docker.internal để tới MySQL trên Windows host
DATABASE_URL=mysql+pymysql://root:yourpassword@host.docker.internal:3306/trohub?charset=utf8mb4

# CORS (optional): danh sách origin dev, phân tách bằng dấu phẩy
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Mặc định backend cho phép thêm Origin dạng mạng nội bộ (192.168/10/172.16–31) để Vite hiển thị link Network.
# Tắt hoàn toàn regex: CORS_ALLOW_PRIVATE_ORIGINS=false
# Ghi đè regex tùy biến: CORS_ORIGIN_REGEX=...
