{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Crawler API (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--reload"
      ],
      "cwd": "${workspaceFolder}/crawler",
      "justMyCode": true
    },
    {
      "name": "Backend API (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload"
      ],
      "cwd": "${workspaceFolder}/backend",
      "justMyCode": true
    }
  ]
}
