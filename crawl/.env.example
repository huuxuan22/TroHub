# Sao chép thành .env (tùy chọn). Ưu tiên dùng chung `DATABASE_URL` với backend:
# đặt `DATABASE_URL=mysql+pymysql://...` trong `backend/.env` — crawl tự đọc file đó.
# Nếu không có DATABASE_URL, dùng các biến MYSQL_* bên dưới.
# API chỉ ghi MySQL (bảng MYSQL_TABLE), không dùng file *.db.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=trohub
MYSQL_TABLE=craw_data