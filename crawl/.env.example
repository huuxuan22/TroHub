# Sao chép thành .env (tùy chọn). Ưu tiên dùng chung `DATABASE_URL` với backend:
# đặt `DATABASE_URL=mysql+pymysql://...` trong `backend/.env` — crawl tự đọc file đó.
# Nếu không có DATABASE_URL, dùng các biến MYSQL_* bên dưới.
# API chỉ ghi MySQL (bảng MYSQL_TABLE), không dùng file *.db.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=trohub
# Trùng tên bảng với migration backend (`crawl_data`).
MYSQL_TABLE=crawl_data

# Số tin mặc định mỗi request (POST body không gửi max_items).
# DEFAULT_CRAWL_MAX_ITEMS=50

# Geocode địa chỉ ngay lúc crawl (chậm). Mặc định tắt — tọa độ lấy từ HTML + backend geocode khi insert rooms.
# GEOCODE_ON_CRAWL=false

# Sau khi crawl: POST danh sách URL tới backend để chuẩn hóa vào `rooms` (để trống = không gọi).
# BACKEND_NORMALIZE_URL=http://127.0.0.1:8000/trohub/internal/crawl/trigger-normalize
# Phải khớp CRAWL_NORMALIZE_WEBHOOK_SECRET trên backend nếu đặt secret.
# CRAWL_NORMALIZE_WEBHOOK_SECRET=