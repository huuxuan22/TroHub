# Copy to .env and adjust. Required for the API and Alembic.

DATABASE_URL=mysql+pymysql://root:password@localhost:3306/trohub?charset=utf8mb4

# Optional default listing page when POST /crawl omits "url"
# DEFAULT_CRAWL_URL=https://example.com/listings

# HTTP client
# HTTP_TIMEOUT_SECONDS=15
# HTTP_USER_AGENT=TroHubCrawler/1.0

# BeautifulSoup CSS selectors (tune per website structure)
# ROOM_ITEM_SELECTOR=.room-item
# ROOM_TITLE_SELECTOR=.title
# ROOM_PRICE_SELECTOR=.price
# ROOM_LOCATION_SELECTOR=.location
# ROOM_IMAGE_SELECTOR=img
# ROOM_DESCRIPTION_SELECTOR=.description
# ROOM_PHONE_SELECTOR=.phone
