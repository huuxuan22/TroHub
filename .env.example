# TroHub — biến tùy chọn cho docker compose (copy thành .env ở root nếu cần)
# MySQL chạy trên Windows; container dùng host.docker.internal

BACKEND_DATABASE_URL=mysql+pymysql://root:yourpassword@host.docker.internal:3306/trohub?charset=utf8mb4
CHATS_DATABASE_URL=mysql+pymysql://root:yourpassword@host.docker.internal:3306/trohub?charset=utf8mb4
CRAWLER_DATABASE_URL=mysql+pymysql://root:yourpassword@host.docker.internal:3306/trohub?charset=utf8mb4

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend (Vite — trình duyệt gọi qua cổng publish trên host)
VITE_API_BASE=http://localhost:8000
VITE_CHATS_HTTP=http://localhost:8001
VITE_CHATS_WS=ws://localhost:8001
VITE_CRAWLER_BASE=http://localhost:8002

# ----- MinIO (object storage — local dev) -----
# Console: http://localhost:9001  |  S3 API: http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
# Trong container FastAPI dùng endpoint minio:9000; từ máy host dùng localhost:9000
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin123
# MINIO_SECURE=false
# Gợi ý bucket: trohub-rooms (ảnh phòng), trohub-avatars (avatar), trohub-crawler (raw crawl)
